{
  "name": "archon-dapp",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "contracts",
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace frontend",
    "chain": "npm run node --workspace contracts",
    "deploy:contracts": "npm run deploy --workspace contracts",
    "deploy:arc": "npm run deploy:arc-testnet --workspace contracts",
    "deploy:arc-mainnet": "npm run deploy:arc-mainnet --workspace contracts",
    "build": "npm run build --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "test": "npm run test --workspace contracts",
    "test:agent": "node scripts/test-agent.js"
  }
}

